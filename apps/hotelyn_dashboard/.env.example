# Copy to .env and fill in for local development if using dotenv tooling.
# Client-safe configuration ONLY.
#
# ARCHITECTURAL SECURITY NOTE:
# This dashboard client NEVER communicates directly with Supabase or the database.
# All data access is mediated through the Hotelyn Dart Frog backend REST API.
# This app NEVER receives backend service-role credentials or direct DB access credentials.
# Any database operations requiring privileged access are strictly handled server-side.
#
# In Flutter, runtime values are typically provided at compile time via:
#   flutter run -d chrome --dart-define-from-file=.dart_defines/local.json
# or via:
#   flutter run -d chrome --dart-define=API_BASE_URL=http://127.0.0.1:8080
#
# Target host resolutions for local development:
#   - Web / Desktop:   http://127.0.0.1:8080
#   - Android Emulator: http://10.0.2.2:8080
#   - Physical Device:  http://<your-machine-LAN-IP>:8080
#
# Environment-specific endpoints:
#   local:      http://127.0.0.1:8080
#   staging:    https://api.staging.hotelyn.com
#   production: https://api.hotelyn.com

# Base URL of the Hotelyn REST backend API (no trailing slash).
API_BASE_URL=http://127.0.0.1:8080
